# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal task data — never commit
/data

# local PGlite database (dev only; real deploys use POSTGRES_URL/DATABASE_URL)
/.data

# Editor/sync duplicate artifacts ("file 2.ts")
*[[:space:]]2.ts
*[[:space:]]2.tsx
*[[:space:]]2.sql
*[[:space:]]2.md
*[[:space:]][0-9].ts
*[[:space:]][0-9].tsx
*[[:space:]][0-9].sql
*[[:space:]][0-9].md
